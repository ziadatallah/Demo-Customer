ISAF_ENVIRONMENT=production
ISAF_REPOSITORY_BACKEND=postgresql
ISAF_STORAGE_QUALIFIED=true
ISAF_STORAGE_QUALIFICATION_FILE=/run/secrets/live-storage-qualification.json
ISAF_DATABASE_URL=postgresql://isaf:CHANGE_ME@postgres:5432/isaf
ISAF_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000
ISAF_S3_ENDPOINT=http://object-storage:9000
ISAF_S3_BUCKET=isaf-production
ISAF_S3_REGION=us-east-1
ISAF_S3_ACCESS_KEY_ID=CHANGE_ME
ISAF_S3_SECRET_ACCESS_KEY=CHANGE_ME
ISAF_S3_PREFIX=production/objects
ISAF_AUTH_MODE=oidc
ISAF_OIDC_ISSUER=https://identity.customer.example
ISAF_OIDC_AUDIENCE=isaf-production
ISAF_OIDC_JWKS_URL=https://identity.customer.example/.well-known/jwks.json
ISAF_DURABLE_BUILDS=true
